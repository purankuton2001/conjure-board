{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stream report",
  "type": "object",
  "required": ["id", "date", "status", "app", "external", "streamer", "persona", "stream_url", "models", "metrics", "checks"],
  "properties": {
    "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "enum": ["pending", "accepted", "held"] },
    "app": { "enum": ["castconjure", "ai-oshibloom"] },
    "external": { "type": "boolean" },
    "streamer": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "handle": { "type": "string" }, "url": { "type": "string" }, "lang": { "type": ["string", "null"], "description": "Creator's own language (ISO 639-1, e.g. ja); basis of the global-reach share" } } },
    "persona": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "folder": { "type": "string" }, "accent": { "type": "string" }, "bundled": { "type": "boolean" } } },
    "stream_url": { "type": "string", "pattern": "^https://" },
    "clip_url": { "type": ["string", "null"] },
    "models": { "type": "object", "required": ["reply"], "properties": { "reply": { "type": "string" }, "code": { "type": "string" } } },
    "metrics": {
      "type": "object",
      "required": ["reactions", "cost_usd"],
      "properties": {
        "reactions": { "type": "integer", "minimum": 0 },
        "languages": { "type": ["object", "null"], "description": "Reactions by reply/comment language from gen_start.lang, e.g. {\"en\":40,\"ko\":10,\"ja\":5}" },
        "acks": { "type": ["integer", "null"] },
        "median_latency_ms": { "type": ["integer", "null"] },
        "p90_latency_ms": { "type": ["integer", "null"] },
        "cost_usd": { "type": "number", "minimum": 0 },
        "director_cost_usd": { "type": ["number", "null"] },
        "views": { "type": ["integer", "null"] },
        "peak_concurrent": { "type": ["integer", "null"] },
        "duration_min": { "type": ["integer", "null"] }
      }
    },
    "checks": {
      "type": "object",
      "required": ["own_oc", "ai_label", "platform_disclosure", "adult"],
      "properties": { "own_oc": { "type": "boolean" }, "ai_label": { "type": "boolean" }, "platform_disclosure": { "type": "boolean" }, "adult": { "type": "boolean" } }
    },
    "issue": { "type": ["integer", "null"] },
    "notes": { "type": "string" }
  }
}
